# Rename this file to .env and fill in your values. Never commit the real .env file.

DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id

# Category (the folder) new ticket channels get created under
TICKET_CATEGORY_ID=channel-category-id

# Role that can see/manage all tickets (your staff/support role)
SUPPORT_ROLE_ID=role-id

# Where closed-ticket logs get posted (optional but recommended)
LOG_CHANNEL_ID=channel-id
